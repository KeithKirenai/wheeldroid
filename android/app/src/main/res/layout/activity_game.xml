<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Game Rendering Surface -->
    <SurfaceView
        android:id="@+id/gameSurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Lightweight Translucent Overlay Container -->
    <FrameLayout
        android:id="@+id/touchOverlayContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.60">

        <!-- Top Left: Item Button (L / Trigger) -->
        <Button
            android:id="@+id/btnItem"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/btn_round_l"
            android:text="L"
            android:textColor="#EEFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Top Right: Pause / Plus Button (+) -->
        <Button
            android:id="@+id/btnPause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/btn_round_ctrl"
            android:text="+"
            android:textColor="#EEFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Bottom Left: Steering D-Pad / Analog Virtual Area -->
        <RelativeLayout
            android:id="@+id/steeringArea"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/btn_round_ctrl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="◀  ▶"
                android:textAlignment="center"
                android:textColor="#BBFFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Bottom Right Controls: A (Gas) and B (Drift) -->
        <RelativeLayout
            android:id="@+id/actionBtnContainer"
            android:layout_width="200dp"
            android:layout_height="180dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp">

            <!-- B Button: Drift / Hop / Brake -->
            <Button
                android:id="@+id/btnDrift"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"
                android:background="@drawable/btn_round_b"
                android:text="B"
                android:textColor="#EEFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- A Button: Accelerate / Gas -->
            <Button
                android:id="@+id/btnGas"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                android:background="@drawable/btn_round_a"
                android:text="A"
                android:textColor="#EEFFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />
        </RelativeLayout>

    </FrameLayout>

    <!-- Dolphin-Style In-Game Settings Menu Drawer (Scrollable & Responsive) -->
    <LinearLayout
        android:id="@+id/ingameMenu"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_gravity="start"
        android:visibility="gone"
        android:background="#E6121820"
        android:elevation="12dp">

        <!-- Fixed Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="In-Game Settings"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="10dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/md_theme_dark_outlineVariant"
            android:layout_marginBottom="6dp" />

        <!-- Scrollable Option Container -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical"
            android:fadeScrollbars="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menuPause"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="8dp"
                    android:text="Pause"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="23dp"
                    app:backgroundTint="@color/md_theme_dark_primary"
                    android:textColor="@color/md_theme_dark_onPrimary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menuTouchControls"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="8dp"
                    android:text="Touch Controls"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="23dp"
                    app:backgroundTint="@color/md_theme_dark_surfaceContainerHigh"
                    android:textColor="@color/md_theme_dark_onSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menuTiltControls"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="8dp"
                    android:text="Tilt Steering"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="23dp"
                    app:backgroundTint="@color/md_theme_dark_surfaceContainerHigh"
                    android:textColor="@color/md_theme_dark_onSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menuNotch"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="8dp"
                    android:text="Notch Area: Extend"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="23dp"
                    app:backgroundTint="@color/md_theme_dark_surfaceContainerHigh"
                    android:textColor="@color/md_theme_dark_onSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menuShowFps"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="8dp"
                    android:text="FPS Overlay: Off"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="23dp"
                    app:backgroundTint="@color/md_theme_dark_surfaceContainerHigh"
                    android:textColor="@color/md_theme_dark_onSurface" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/md_theme_dark_outlineVariant"
                    android:layout_marginVertical="8dp" />

                <!-- Touch Controls Layout Editor -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menuEditLayout"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="8dp"
                    android:text="✏️  Edit Touch Layout"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="23dp"
                    app:backgroundTint="@color/md_theme_dark_surfaceContainerHigh"
                    android:textColor="@color/md_theme_dark_onSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menuResetLayout"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="8dp"
                    android:text="↺  Reset Layout"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="23dp"
                    app:backgroundTint="@color/md_theme_dark_surfaceContainerHigh"
                    android:textColor="@color/md_theme_dark_onSurface" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/md_theme_dark_outlineVariant"
                    android:layout_marginVertical="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menuExit"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="12dp"
                    android:text="Exit to Launcher"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="23dp"
                    app:backgroundTint="@color/md_theme_dark_secondaryContainer"
                    android:textColor="@color/md_theme_dark_onSecondaryContainer" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</FrameLayout>
