<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_dark_background"
    android:fitsSystemWindows="true">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_dark_background"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_wheeldroid_header"
                android:scaleType="fitCenter"
                android:contentDescription="WheelDroid Logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="WheelDroid"
                android:textColor="@color/md_theme_dark_onBackground"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.01" />

            <!-- Quick Advanced Settings Gear -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdvancedSettings"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:icon="@drawable/ic_settings"
                app:iconSize="22dp"
                app:iconTint="@color/md_theme_dark_onSurfaceVariant" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="32dp">

            <!-- GAME HERO CARD (Dolphin / Console style) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/md_theme_dark_surfaceContainer"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/md_theme_dark_outlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Game Icon / Cover Artwork -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/md_theme_dark_surfaceContainerHighest">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_wheeldroid_header"
                                android:scaleType="centerInside"
                                android:padding="10dp"
                                android:contentDescription="Game Cover" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mario Kart Wii"
                                android:textColor="@color/md_theme_dark_onSurface"
                                android:textSize="20sp"
                                android:fontFamily="sans-serif-medium"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Static Recompilation • PAL (RMCP01)"
                                android:textColor="@color/md_theme_dark_onSurfaceVariant"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />

                            <!-- Status Badge -->
                            <LinearLayout
                                android:id="@+id/headerStatusBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="@drawable/bg_key_badge"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:layout_marginTop="6dp">

                                <ImageView
                                    android:id="@+id/headerStatusIcon"
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:src="@drawable/ic_check_circle"
                                    android:contentDescription="Status Icon"
                                    android:layout_marginEnd="4dp" />

                                <TextView
                                    android:id="@+id/headerStatusText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ready to Play"
                                    android:textColor="@color/status_ready"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/md_theme_dark_outlineVariant"
                        android:layout_marginVertical="16dp" />

                    <!-- Primary Action Buttons -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/launchBtn"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="Launch Game"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_play_arrow"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconSize="22dp"
                        app:iconTint="@color/md_theme_dark_onPrimary"
                        app:cornerRadius="16dp"
                        android:enabled="false"
                        app:backgroundTint="@color/md_theme_dark_primary"
                        android:textColor="@color/md_theme_dark_onPrimary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnInstallGameData"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:text="Install / Change Disc (.iso / .wbfs)"
                        android:textSize="14sp"
                        app:icon="@drawable/ic_disc"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconSize="18dp"
                        app:cornerRadius="14dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION: GRAPHICS & PERFORMANCE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GRAPHICS &amp; PERFORMANCE"
                android:textColor="@color/md_theme_dark_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/md_theme_dark_surfaceContainer"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/md_theme_dark_outlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Resolution Scale Slider -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_resolution_accent"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Resolution Icon" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Resolution Scale"
                            android:textColor="@color/md_theme_dark_onSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textResolution"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.0x (100%)"
                            android:textColor="@color/md_theme_dark_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderResolution"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0.0"
                        android:valueTo="5.0"
                        android:stepSize="1.0"
                        android:value="2.0"
                        app:thumbColor="@color/md_theme_dark_primary"
                        app:trackColorActive="@color/md_theme_dark_primary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/md_theme_dark_outlineVariant"
                        android:layout_marginVertical="8dp" />

                    <!-- Custom GPU Driver -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_cpu_perf"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="GPU Driver Icon" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vulkan Driver"
                                android:textColor="@color/md_theme_dark_onSurface"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textCurrentDriver"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="System Default"
                                android:textColor="@color/md_theme_dark_onSurfaceVariant"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnInstallDriver"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Install ZIP"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Spinner
                        android:id="@+id/spinnerCustomDriver"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:backgroundTint="@color/md_theme_dark_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION: CONTROLS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONTROLS &amp; INPUT"
                android:textColor="@color/md_theme_dark_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/md_theme_dark_surfaceContainer"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/md_theme_dark_outlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditTouchLayout"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Edit Touch Layout"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_touch_accent"
                        app:iconSize="18dp"
                        app:cornerRadius="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRemapper"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="Controller Remap"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_controller"
                        app:iconSize="18dp"
                        app:cornerRadius="14dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION: MAINTENANCE & DIAGNOSTICS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIAGNOSTICS &amp; DATA"
                android:textColor="@color/md_theme_dark_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/md_theme_dark_surfaceContainer"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/md_theme_dark_outlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/exportLogsBtn"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="Share Logs"
                            android:textSize="13sp"
                            app:icon="@drawable/ic_share"
                            app:iconSize="16dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearLogs"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="Clear Logs"
                            android:textColor="@color/status_warning"
                            android:textSize="13sp"
                            app:icon="@drawable/ic_delete_sweep"
                            app:iconTint="@color/status_warning"
                            app:iconSize="16dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDeleteGameData"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:text="Uninstall Game Data (Disc Files)"
                        android:textColor="@color/status_warning"
                        app:icon="@drawable/ic_delete_sweep"
                        app:iconTint="@color/status_warning"
                        app:iconSize="14dp"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWipeSaveData"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:text="Reset Save Data (NAND)"
                        android:textColor="@color/md_theme_dark_outline"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>